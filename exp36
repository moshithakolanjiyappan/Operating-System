#include <stdio.h>
#include <stdlib.h>

int main()
{
    FILE *fp;
    char data[100];

    /* Create and write */
    fp = fopen("sample.txt", "w");

    if (fp == NULL)
    {
        printf("Unable to create file.\n");
        return 1;
    }

    printf("Enter text to write into file: ");
    fgets(data, sizeof(data), stdin);

    fputs(data, fp);
    fclose(fp);

    printf("\nFile created and data written successfully.\n");

    /* Read */
    fp = fopen("sample.txt", "r");

    if (fp == NULL)
    {
        printf("Unable to open file.\n");
        return 1;
    }

    printf("\nFile contents:\n");

    while (fgets(data, sizeof(data), fp) != NULL)
    {
        printf("%s", data);
    }

    fclose(fp);

    /* Append */
    fp = fopen("sample.txt", "a");

    if (fp == NULL)
    {
        printf("Unable to open file for append.\n");
        return 1;
    }

    fputs("\nData appended successfully.", fp);
    fclose(fp);

    printf("\n\nData appended successfully.\n");

    /* Rename */
    if (rename("sample.txt", "newfile.txt") == 0)
        printf("File renamed successfully.\n");
    else
        printf("File rename failed.\n");

    /* Delete */
    if (remove("newfile.txt") == 0)
        printf("File deleted successfully.\n");
    else
        printf("File deletion failed.\n");

    return 0;
}
