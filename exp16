#include <stdio.h>
#include <stdlib.h>

struct Employee
{
    int empid;
    char name[30];
    float salary;
};

int main()
{
    FILE *fp;
    struct Employee emp;
    int choice, id;

    fp = fopen("employee.dat", "rb+");

    if (fp == NULL)
        fp = fopen("employee.dat", "wb+");

    do
    {
        printf("\n--- Employee Record Menu ---\n");
        printf("1. Add Employee\n");
        printf("2. Display Employee\n");
        printf("3. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
        case 1:
            printf("Enter Employee ID (0-99): ");
            scanf("%d", &emp.empid);

            printf("Enter Name: ");
            scanf("%s", emp.name);

            printf("Enter Salary: ");
            scanf("%f", &emp.salary);

            fseek(fp, emp.empid * sizeof(struct Employee), SEEK_SET);
            fwrite(&emp, sizeof(struct Employee), 1, fp);

            printf("Record Stored Successfully.\n");
            break;

        case 2:
            printf("Enter Employee ID to Search: ");
            scanf("%d", &id);

            fseek(fp, id * sizeof(struct Employee), SEEK_SET);
            fread(&emp, sizeof(struct Employee), 1, fp);

            if (emp.empid == id)
            {
                printf("\nEmployee Details\n");
                printf("ID     : %d\n", emp.empid);
                printf("Name   : %s\n", emp.name);
                printf("Salary : %.2f\n", emp.salary);
            }
            else
            {
                printf("Record Not Found.\n");
            }
            break;

        case 3:
            printf("Program Terminated.\n");
            break;

        default:
            printf("Invalid Choice.\n");
        }

    } while (choice != 3);

    fclose(fp);

    return 0;
}
