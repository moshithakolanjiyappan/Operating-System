#include <stdio.h>
#include <stdlib.h>

int main()
{
    int request[50];
    int n, head, diskSize;
    int direction;
    int i, j, temp;
    int total = 0;

    printf("Enter number of requests: ");
    scanf("%d", &n);

    printf("Enter request queue:\n");

    for (i = 0; i < n; i++)
        scanf("%d", &request[i]);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    printf("Enter disk size: ");
    scanf("%d", &diskSize);

    printf("Enter direction (1 = Right, 0 = Left): ");
    scanf("%d", &direction);

    /* Sort request queue */
    for (i = 0; i < n - 1; i++)
    {
        for (j = i + 1; j < n; j++)
        {
            if (request[i] > request[j])
            {
                temp = request[i];
                request[i] = request[j];
                request[j] = temp;
            }
        }
    }

    printf("\nSeek Sequence:\n");
    printf("%d", head);

    if (direction == 1)
    {
        /* Move right */
        for (i = 0; i < n; i++)
        {
            if (request[i] >= head)
            {
                total += abs(head - request[i]);
                head = request[i];
                printf(" -> %d", head);
            }
        }

        /* Move to end */
        if (head != diskSize - 1)
        {
            total += abs(head - (diskSize - 1));
            head = diskSize - 1;
            printf(" -> %d", head);
        }

        /* Move left */
        for (i = n - 1; i >= 0; i--)
        {
            if (request[i] < head)
            {
                total += abs(head - request[i]);
                head = request[i];
                printf(" -> %d", head);
            }
        }
    }
    else
    {
        /* Move left */
        for (i = n - 1; i >= 0; i--)
        {
            if (request[i] <= head)
            {
                total += abs(head - request[i]);
                head = request[i];
                printf(" -> %d", head);
            }
        }

        /* Move to beginning */
        if (head != 0)
        {
            total += head;
            head = 0;
            printf(" -> %d", head);
        }

        /* Move right */
        for (i = 0; i < n; i++)
        {
            if (request[i] > head)
            {
                total += abs(head - request[i]);
                head = request[i];
                printf(" -> %d", head);
            }
        }
    }

    printf("\n\nTotal Head Movement = %d cylinders\n", total);

    return 0;
}
