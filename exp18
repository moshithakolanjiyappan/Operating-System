#include <stdio.h>

int main() {
    int bufferSize, item;
    int full = 0, empty, mutex = 1;

    printf("Enter buffer size: ");
    scanf("%d", &bufferSize);

    empty = bufferSize;

    printf("Enter item to produce: ");
    scanf("%d", &item);

    if(mutex==1 && empty!=0){
        mutex=0;
        empty--;
        full++;
        printf("Producer produced: %d\n",item);
        mutex=1;
    }

    if(mutex==1 && full!=0){
        mutex=0;
        full--;
        empty++;
        printf("Consumer consumed: %d\n",item);
        mutex=1;
    }

    return 0;
}
