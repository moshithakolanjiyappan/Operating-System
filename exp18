#include <stdio.h>
#include <pthread.h>
#include <semaphore.h>

#define MAX 10

int buffer[MAX];
int in = 0, out = 0;
int item, size;

sem_t empty, full, mutex;

void *producer(void *arg)
{
    printf("Enter item to produce: ");
    scanf("%d", &item);

    sem_wait(&empty);
    sem_wait(&mutex);

    buffer[in] = item;
    printf("Producer produced: %d\n", item);
    in = (in + 1) % size;

    sem_post(&mutex);
    sem_post(&full);

    return NULL;
}

void *consumer(void *arg)
{
    int consumed;

    sem_wait(&full);
    sem_wait(&mutex);

    consumed = buffer[out];
    printf("Consumer consumed: %d\n", consumed);
    out = (out + 1) % size;

    sem_post(&mutex);
    sem_post(&empty);

    return NULL;
}

int main()
{
    pthread_t p, c;

    printf("Enter buffer size (Max 10): ");
    scanf("%d", &size);

    sem_init(&empty, 0, size);
    sem_init(&full, 0, 0);
    sem_init(&mutex, 0, 1);

    pthread_create(&p, NULL, producer, NULL);
    pthread_create(&c, NULL, consumer, NULL);

    pthread_join(p, NULL);
    pthread_join(c, NULL);

    sem_destroy(&empty);
    sem_destroy(&full);
    sem_destroy(&mutex);

    return 0;
}
